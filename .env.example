# Modelo das variáveis de ambiente. NÃO coloque valores reais neste arquivo.
#
# Na Vercel: Settings → Environment Variables → crie as duas abaixo.
# No seu computador (opcional): copie este arquivo como ".env.local" e preencha.
#
# Onde achar no Supabase: botão "Connect" (topo da tela) ou
# Project Settings → Data API (URL) e API Keys (chave publishable / anon).
# As duas são públicas por natureza; quem protege os dados é o login + RLS.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
